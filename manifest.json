{
  "id": "group-channels",
  "contexts": ["household", "shared_space"],
  "name": "Group Channels",
  "version": "1.1.0",
  "description": "Persistent named channels for org-level discussion. Leadership manages channels; everyone reads and posts in channels they belong to.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "db",
  "category": "organization",
  "tags": [
    "channels",
    "messaging",
    "discussion",
    "organization"
  ],
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "resource_limits": {
    "max_db_bytes": 52428800,
    "max_files_bytes": 524288000,
    "max_store_reads_per_day": 2000,
    "max_store_writes_per_day": 500
  },
  "member_references": {
    "channels": { "column": "created_by", "on_removed": "keep" },
    "channel_members": { "column": "member_id", "on_removed": "delete", "id_column": "rowid" },
    "messages": { "column": "author_id", "on_removed": "keep" },
    "message_files": { "column": "author_id", "on_removed": "keep" },
    "channel_subscriptions": { "column": "member_id", "on_removed": "delete", "id_column": "rowid" },
    "member_last_read": { "column": "member_id", "on_removed": "delete", "id_column": "rowid" }
  },
  "nav": { "label": "Channels" },
  "icon": "#️⃣",
  "admin_config": {
    "settings_table": "settings",
    "keys": ["leadership_group_id"]
  },
  "db_plaintext_columns": ["membership_type", "membership_roles", "name", "slug"],
  "row_policies": {
    "settings": {
      "kind": "app_config"
    },
    "channels": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["all"],
      "insert_privileged_only": true,
      "write_privileged_only": true,
      "privileged_groups": [
        { "settings_table": "settings", "settings_key": "leadership_group_id" }
      ]
    },
    "channel_members": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": false,
      "insert_privileged_only": true,
      "privileged_groups": [
        { "settings_table": "settings", "settings_key": "leadership_group_id" }
      ]
    },
    "messages": {
      "kind": "channel_scoped",
      "channels_table": "channels",
      "channel_id_column": "channel_id",
      "membership_type_column": "membership_type",
      "membership_roles_column": "membership_roles",
      "membership_table": "channel_members",
      "membership_channel_column": "channel_id",
      "membership_member_column": "member_id",
      "self_column": "author_id",
      "all_value": "all",
      "role_value": "role",
      "retain_days": {
        "default": 365,
        "timestamp_column": "created_at",
        "override_key": "message_history",
        "dependent_tables": [
          { "table": "message_files", "foreign_key": "message_id", "file_id_column": "file_id" }
        ]
      }
    },
    "message_files": {
      "kind": "channel_scoped",
      "channels_table": "channels",
      "channel_id_column": "channel_id",
      "membership_type_column": "membership_type",
      "membership_roles_column": "membership_roles",
      "membership_table": "channel_members",
      "membership_channel_column": "channel_id",
      "membership_member_column": "member_id",
      "self_column": "author_id",
      "all_value": "all",
      "role_value": "role"
    },
    "member_last_read": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": false
    },
    "channel_subscriptions": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": false
    }
  },
  "subscription_notify": {
    "subscription_table": "channel_subscriptions",
    "topic_column": "channel_id",
    "member_column": "member_id",
    "eligibility": {
      "kind": "channel_membership",
      "channels_table": "channels",
      "membership_type_column": "membership_type",
      "membership_roles_column": "membership_roles",
      "membership_table": "channel_members",
      "membership_channel_column": "channel_id",
      "membership_member_column": "member_id"
    }
  }
}
